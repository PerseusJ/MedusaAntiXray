{"nodes": [{"id": "resources_config", "label": "Medusa Anti-Xray Configuration", "file_type": "code", "source_file": "src/main/resources/config.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "resources_config_medusa_anti_xray", "label": "Medusa Anti-Xray", "file_type": "concept", "source_file": "src/main/resources/config.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Plugin designed to detect X-ray users via statistical analysis of mined blocks. Uses ratio of weighted suspicious ore score to total blocks, comparing against natural occurrence rates (~1-2%) to flag anomalous behavior."}, {"id": "resources_config_detection_system", "label": "Detection System", "file_type": "concept", "source_file": "src/main/resources/config.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sliding window (30 min) tracks player mining. Block exposure determines suspicion weight: fully hidden ores score 1.0, cave-exposed ores score 0.25. Minimum 64 blocks required before evaluation to prevent early false flags. Alert fires at ratio >= 8%."}, {"id": "resources_config_alert_system", "label": "Alert System", "file_type": "concept", "source_file": "src/main/resources/config.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "60-second cooldown prevents chat spam. Staff permission gate (medusa.staff). Configurable prefix with hex color support. Formatted alert message exposes player, ratio, score, and total block count."}, {"id": "resources_config_ratio_algorithm", "label": "Ratio Detection Algorithm", "file_type": "rationale", "source_file": "src/main/resources/config.yml", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "resources_config_overw